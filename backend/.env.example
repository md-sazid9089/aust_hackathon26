# Copy to backend/.env and fill in. Never commit .env.

# --- runtime ---------------------------------------------------------------
ENV=dev                                   # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
STORAGE_DIR=./storage                     # uploaded files (local backend; Supabase Storage later)
SEED_DATA_DIR=../data/seed-data           # demo dataset used by POST /api/v1/demo/seed
RATE_LIMIT_ENABLED=true

# --- database --------------------------------------------------------------
# Supabase project etzxqeilgohiavdeybbw. Use the postgresql+asyncpg:// scheme; percent-encode special chars in the password.
# Shared pooler (IPv4) — transaction mode for the app (session.py disables the asyncpg statement cache):
# DATABASE_URL=postgresql+asyncpg://postgres.etzxqeilgohiavdeybbw:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session-mode pooler (5432) for migrations/psql; direct host db.etzxqeilgohiavdeybbw.supabase.co:5432 (user postgres) is IPv6-only.
# Do NOT append ?pgbouncer=true — that is a Prisma-only flag; asyncpg rejects unknown params.
# Local development default (no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- auth ------------------------------------------------------------------
AUTH_MODE=dev                             # dev = fixed local faculty user (no token) | supabase = verify Supabase JWT
DEV_USER_EMAIL=faculty.dev@example.edu
SUPABASE_URL=                             # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=                 # sb_publishable_… (safe for clients; same value as frontend VITE_SUPABASE_ANON_KEY)
SUPABASE_SECRET_KEY=                      # sb_secret_… server-only (Storage/admin API); NEVER ship to the frontend
SUPABASE_JWKS_URL=                        # optional; default = ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256 tokens)
SUPABASE_JWT_SECRET=                      # optional; only for legacy HS256 projects

# --- AI --------------------------------------------------------------------
LLM_PROVIDER=mock                         # mock | openrouter | openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODELS=google/gemini-2.5-flash
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
EMBED_BASE_URL=                           # default = LLM_BASE_URL
EMBED_API_KEY=                            # default = LLM_API_KEY
EMBED_MODEL=openai/text-embedding-3-small
