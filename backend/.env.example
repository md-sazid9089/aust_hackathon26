# Copy to backend/.env and fill in. Never commit .env.

# --- runtime ---------------------------------------------------------------
ENV=dev                                   # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
STORAGE_DIR=./storage                     # uploaded files (local backend; Supabase Storage later)
SEED_DATA_DIR=../data/seed-data           # demo dataset used by POST /api/v1/demo/seed
RATE_LIMIT_ENABLED=true

# --- database --------------------------------------------------------------
# Production (Supabase / Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
# Local development default (no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- auth ------------------------------------------------------------------
AUTH_MODE=dev                             # dev = fixed local faculty user (no token) | supabase = verify HS256 JWT
DEV_USER_EMAIL=faculty.dev@example.edu
SUPABASE_JWT_SECRET=                      # required when AUTH_MODE=supabase

# --- AI --------------------------------------------------------------------
LLM_PROVIDER=mock                         # mock | openrouter | openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODELS=google/gemini-2.5-flash
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
EMBED_BASE_URL=                           # default = LLM_BASE_URL
EMBED_API_KEY=                            # default = LLM_API_KEY
EMBED_MODEL=openai/text-embedding-3-small
