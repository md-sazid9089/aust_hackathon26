# Copy to .env.local — never commit real values
# On Vercel set these in Project → Settings → Environment Variables (build-time; redeploy after changes).
VITE_API_MODE=mock            # mock | live
# Local dev: /api/v1 (proxied by vite.config.ts). Vercel/live: absolute backend URL,
# e.g. https://<backend-host>/api/v1 — backend CORS_ORIGINS must include the Vercel origin.
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_MODE=supabase        # supabase | local | dev (must match backend AUTH_MODE; dev never in prod)
